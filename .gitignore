# --- Bible data ---
# Zdrojové texty překladů (mohou podléhat autorským právům) a z nich
# vygenerovaná databáze se do gitu neukládají. Vytvoř je příkazem:
#   python3 tool/build_bible_db.py --fetch
/data/sources/*
!/data/sources/README.md
/assets/db/bible.db
/assets/db/bible_manifest.json
/assets/db/catalog.json
/data/study_sources/
/assets/db/study_manifest.json
/assets/map/basemap.json
__pycache__/
/assets/map/places.json
